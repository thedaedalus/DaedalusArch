{
  "restore_on_startup": "launchpad",
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff", "codebook", "color-lsp"],
      "format_on_save": "on",
      "colorize_brackets": true,
      "completions": {
        "words_min_length": 2,
      },
      "show_completions_on_input": true,
      "indent_guides": {
        "coloring": "indent_aware",
      },
      "auto_indent_on_paste": false,
    },
  },
  "edit_predictions": {
    "mode": "subtle",
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "settings": {
        "github_personal_access_token":
      },
    },
  },
  "features": {
    "edit_prediction_provider": "zed",
  },
  "session": {
    "trust_all_worktrees": false,
  },
  "ui_font_family": "MesloLGS Nerd Font Mono",
  "buffer_font_family": "MesloLGS Nerd Font Mono",
  "icon_theme": "Catppuccin Macchiato",
  "terminal": {
    "font_family": "MesloLGS Nerd Font Mono",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "auto",
  },
  "file_types": {},
  "ui_font_size": 16,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },

  "autosave": "on_focus_change",
  "project_panel": {
    "button": true,
    "default_width": 240,
    "dock": "right",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": false,
    "drag_and_drop": true,
    "scrollbar": {
      "show": null,
    },
    "sticky_scroll": true,
    "show_diagnostics": "all",
    "indent_guides": {
      "show": "always",
    },
    "sort_mode": "directories_first",
    "hide_root": false,
    "hide_hidden": false,
    "starts_open": true,
    "auto_open": {
      "on_create": true,
      "on_paste": true,
      "on_drop": true,
    },
  },
  "git_panel": {
    "button": true,
    "dock": "right",
    "default_width": 360,
    "status_style": "icon",
    "fallback_branch_name": "main",
    "sort_by_path": false,
    "collapse_untracked_diff": false,
    "scrollbar": {
      "show": null,
    },
  },
  "outline_panel": {
    "button": true,
    "default_width": 300,
    "dock": "right",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "indent_guides": {
      "show": "always",
    },
    "scrollbar": {
      "show": null,
    },
  },
  "collaboration_panel": {
    "button": true,
    "dock": "right",
    "default_width": 240,
  },
}
